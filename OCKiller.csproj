<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net10.0-windows10.0.19041.0</TargetFramework>
    <TargetPlatformMinVersion>10.0.17763.0</TargetPlatformMinVersion>
    <SupportedOSPlatformVersion>10.0.17763.0</SupportedOSPlatformVersion>
    <RootNamespace>OCKiller</RootNamespace>
    <ApplicationManifest>app.manifest</ApplicationManifest>
    <ApplicationIcon>Assets\app.ico</ApplicationIcon>
    <Platforms>x64</Platforms>
    <RuntimeIdentifier>win-x64</RuntimeIdentifier>
    <RuntimeIdentifiers>win-x64</RuntimeIdentifiers>
    <UseWinUI>true</UseWinUI>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <LangVersion>latest</LangVersion>
    <Version>1.0.0</Version>
    <DefaultItemExcludes>$(DefaultItemExcludes);dist\**;bin\**;obj\**</DefaultItemExcludes>

    <!-- Unpackaged, no MSIX needed. WinAppSDK runtime is bundled next to the exe. -->
    <WindowsPackageType>None</WindowsPackageType>
    <WindowsAppSDKSelfContained>true</WindowsAppSDKSelfContained>
    <EnableMsixTooling>false</EnableMsixTooling>
    <AppxPackage>false</AppxPackage>
    <GenerateAppInstallerFile>false</GenerateAppInstallerFile>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.WindowsAppSDK" Version="1.8.260921001" />
    <Content Remove="Assets\app.png" />
    <None Remove="Assets\app.png" />
    <EmbeddedResource Include="Assets\app.png" LogicalName="OCKiller.Assets.app.png" />
  </ItemGroup>

  <!--
    dotnet publish does not copy the app's compiled resources (PRI) for unpackaged
    WinUI apps, which makes the published exe crash in Microsoft.UI.Xaml.dll.
    Copy it next to the exe after publish.
  -->
  <Target Name="CopyAppPriToPublishOutput"
          AfterTargets="Publish"
          Condition="Exists('$(TargetDir)$(AssemblyName).pri')">
    <Copy SourceFiles="$(TargetDir)$(AssemblyName).pri"
          DestinationFiles="$(PublishDir)$(AssemblyName).pri"
          SkipUnchangedFiles="true" />
  </Target>

</Project>
