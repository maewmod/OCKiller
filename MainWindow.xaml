<Window
    x:Class="OCKiller.MainWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    mc:Ignorable="d"
    Title="OCKiller - IP Reset">

    <Grid x:Name="RootGrid"
          Background="Transparent"
          RequestedTheme="Dark">

        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <!-- Custom title bar -->
        <Grid x:Name="AppTitleBar"
              Grid.Row="0"
              Height="48"
              Padding="20,0,150,0"
              Background="Transparent">
            <StackPanel Orientation="Horizontal"
                        Spacing="10"
                        VerticalAlignment="Center">
                <Image x:Name="TitleBarLogo"
                       Width="20"
                       Height="20"
                       Stretch="Uniform" />
                <TextBlock Text="OCKiller"
                           FontSize="12"
                           FontWeight="SemiBold"
                           VerticalAlignment="Center" />
                <TextBlock Text="Cloudflare WARP"
                           FontSize="12"
                           Foreground="{ThemeResource TextFillColorTertiaryBrush}"
                           VerticalAlignment="Center" />
            </StackPanel>
        </Grid>

        <!-- Content -->
        <Grid Grid.Row="1" Padding="28,4,28,24">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="*" />
                <RowDefinition Height="Auto" />
            </Grid.RowDefinitions>

            <!-- Header -->
            <StackPanel Grid.Row="0" Spacing="4" Margin="0,0,0,20">
                <TextBlock Text="OCKiller" Style="{StaticResource TitleTextBlockStyle}" />
                <TextBlock Text="Reset your IP with Cloudflare WARP for opencode"
                           Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                           FontSize="13" />
            </StackPanel>

            <!-- Current IP card -->
            <Border Grid.Row="1"
                    Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
                    BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                    BorderThickness="1"
                    CornerRadius="10"
                    Padding="20"
                    Margin="0,0,0,16">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                    </Grid.RowDefinitions>

                    <TextBlock Grid.Row="0"
                               Text="Current IP"
                               Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                               FontSize="12" />

                    <TextBlock x:Name="IpText"
                               Grid.Row="1"
                               Text="-"
                               FontFamily="Consolas"
                               FontSize="30"
                               FontWeight="SemiBold"
                               TextWrapping="Wrap"
                               IsTextSelectionEnabled="True"
                               Margin="0,4,0,0" />

                    <StackPanel Grid.Row="2"
                                Orientation="Horizontal"
                                Spacing="8"
                                Margin="0,8,0,0">
                        <FontIcon x:Name="StatusIcon"
                                  Glyph="&#xE946;"
                                  FontSize="12"
                                  Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                  VerticalAlignment="Center" />
                        <TextBlock x:Name="StatusText"
                                   Text="Checking..."
                                   Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                   FontSize="12"
                                   TextWrapping="Wrap"
                                   VerticalAlignment="Center" />
                    </StackPanel>

                    <Button x:Name="CopyButton"
                            Grid.Column="1"
                            Grid.RowSpan="3"
                            Click="CopyButton_Click"
                            VerticalAlignment="Center"
                            IsEnabled="False"
                            AutomationProperties.Name="Copy IP"
                            ToolTipService.ToolTip="Copy IP">
                        <StackPanel Orientation="Horizontal" Spacing="6">
                            <FontIcon Glyph="&#xE8C8;" FontSize="13" />
                            <TextBlock Text="Copy" />
                        </StackPanel>
                    </Button>
                </Grid>
            </Border>

            <!-- Actions -->
            <StackPanel Grid.Row="2"
                        Orientation="Horizontal"
                        Spacing="10"
                        Margin="0,0,0,12">
                <Button x:Name="ResetButton"
                        Content="Reset IP"
                        Style="{StaticResource AccentButtonStyle}"
                        MinWidth="150"
                        IsEnabled="False"
                        Click="ResetButton_Click"
                        ToolTipService.ToolTip="Delete the WARP registration and create a new one to change your IP" />
                <Button x:Name="RefreshButton"
                        Content="Refresh IP"
                        Click="RefreshButton_Click" />
                <Button x:Name="InstallButton"
                        Content="Install WARP"
                        Visibility="Collapsed"
                        Click="InstallButton_Click" />
            </StackPanel>

            <ProgressBar x:Name="Progress"
                         Grid.Row="3"
                         IsIndeterminate="True"
                         Visibility="Collapsed"
                         Height="3"
                         Margin="0,0,0,12" />

            <!-- Footer -->
            <Grid Grid.Row="5" Margin="0,0,0,0">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>

                <TextBlock x:Name="HintText"
                           Text="Ready"
                           Foreground="{ThemeResource TextFillColorTertiaryBrush}"
                           FontSize="11"
                           VerticalAlignment="Center"
                           TextTrimming="CharacterEllipsis"
                           Margin="0,0,12,0" />

                <StackPanel Grid.Column="1"
                            Orientation="Horizontal"
                            Spacing="8"
                            VerticalAlignment="Center">
                    <HyperlinkButton x:Name="OpenLogButton"
                                     Content="Open log"
                                     Padding="8,4"
                                     Click="OpenLogButton_Click"
                                     ToolTipService.ToolTip="Open the log file" />
                    <Button Content="Close"
                            Click="CloseButton_Click" />
                </StackPanel>
            </Grid>
        </Grid>
    </Grid>
</Window>
